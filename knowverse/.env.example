# ================================================================
# KnowVerse — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ================================================================

# --- Database ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/knowverse"

# --- JWT ---
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3001"

# --- File Uploads ---
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# --- AI Service ---
AI_SERVICE_URL="http://localhost:8000"

# --- AI/LLM Provider (choose one: gemini | openai | none) ---
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# --- Cookie ---
COOKIE_SECRET="replace-with-another-long-random-secret"

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
